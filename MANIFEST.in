include CHANGELOG.md
recursive-include kivyforge *.py
# Objective-C bootstrap templates and the asset-catalog helper ship with the wheel.
recursive-include kivyforge/platforms/ios/templates *
recursive-include kivyforge/tools *.py

prune .git
# setuptools' legacy sdist default sweeps in top-level tests/test*.py, which
# picked up exactly one file (tests/test_icon.py) while the rest of the suite
# lives in subdirectories -- an incoherent partial. The suite is not shipped;
# it runs from the repo (tox/pytest), and the git tag is the reference for
# anyone who wants it.
prune tests

# setuptools-scm adds every git-tracked file to the sdist. The sdist carries the
# package and what building it needs, as before; docs, examples, CI and repo
# housekeeping stay in the repo (12 MB / 643 files otherwise, against 1.3 MB).
prune docs
prune examples
prune scripts
prune .github
prune .cursor
exclude .coveragerc .git_archival.txt .gitattributes .gitignore
exclude AGENTS.md CODE_OF_CONDUCT.md CONTACT.md CONTRIBUTING.md FAQ.md
exclude mkdocs.yml pyrightconfig.json renovate.json tox.ini
