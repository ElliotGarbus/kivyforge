# Keep shell scripts LF even on Windows checkouts (autocrlf): bash rejects CRLF
# (`set -euo pipefail\r` -> "invalid option name"). Applies to build_native.sh,
# the verify-*.sh helpers, and any AppRun/entrypoint scripts.
*.sh text eol=lf

# PowerShell scripts are Windows-native; keep them CRLF.
*.ps1 text eol=crlf
