# Keep shell scripts LF even on Windows checkouts (autocrlf): bash rejects CRLF
# (`set -euo pipefail\r` -> "invalid option name"). Applies to build_native.sh,
# the verify-*.sh helpers, and any AppRun/entrypoint scripts.
*.sh text eol=lf

# Code vendored from python-for-android stays byte-for-byte as upstream has it
# (LF), so a Windows checkout reads what scripts/sync_p4a.py compares against.
kivyforge/platforms/android/bootstrap/templates/p4a/** text eol=lf

# PowerShell scripts are Windows-native; keep them CRLF.
*.ps1 text eol=crlf

# setuptools-scm reads the version from this file when building a tree that has
# no .git (git archive, a GitHub ZIP download, a pip install of archive/<sha>.zip).
.git_archival.txt export-subst
