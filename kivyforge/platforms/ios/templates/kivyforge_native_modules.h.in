/*
 * Per-project inittab for native Python extension modules. Regenerated by
 * `kivyforge build`. Do not edit by hand.
 *
 * Some packages implement a Python extension module in Swift rather than in
 * Python — the Swift is compiled into the app target against this app's own
 * interpreter, so there is no shared object for the import machinery to find
 * and `dlopen` never runs. Such a module is invisible to `import` until it is
 * registered with the interpreter, which must happen before
 * Py_InitializeFromConfig. That registration is what this table drives; see
 * native-integration SPEC.md §7.7.
 *
 * Empty is the normal case: an app whose packages contribute no native modules
 * gets a table with only the terminator, and the loop in
 * kivyforge_bootstrap.m does nothing.
 */
#ifndef KIVYFORGE_NATIVE_MODULES_H
#define KIVYFORGE_NATIVE_MODULES_H

#include <Python.h>

/* Module init functions have C linkage even when defined in Swift. */
@NATIVE_MODULE_EXTERNS@

typedef struct {
    const char *name;         /* the name Python imports */
    PyObject *(*initfunc)(void);
} KivyforgeNativeModule;

/* NULL-terminated; iterated by kivyforge_register_native_modules(). */
static const KivyforgeNativeModule kivyforge_native_modules[] = {
@NATIVE_MODULE_ENTRIES@    {NULL, NULL}
};

#endif /* KIVYFORGE_NATIVE_MODULES_H */
